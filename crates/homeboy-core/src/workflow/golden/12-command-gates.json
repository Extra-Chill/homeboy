          "any": [
            {
              "command": [
                "homeboy",
                "review",
                "lint"
              ]
            },
            {
              "command": [
                "test",
                "-f",
                "x"
              ]
            }
          ]
        }
      },
      {
        "exec": {
          "program": "true"
        },
        "id": "never",
        "needs": [
          "lint"
        ],
        "when": {
          "command": [
            "false"
          ]
        }
      }
    ]
  },
