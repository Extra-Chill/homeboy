{
  "definition": {
    "id": "cmdgate",
    "iterate": {
      "max_iterations": 2,
      "until": {
        "command": [
          "homeboy",
          "review",
          "lint",
          "{{iteration}}"
        ]
      }
    },
    "schema": "homeboy/workflow/v1",
