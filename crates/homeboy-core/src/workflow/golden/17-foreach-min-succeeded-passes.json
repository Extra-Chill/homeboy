{
  "definition": {
    "id": "fan",
    "inputs": {
      "issues": {
        "required": true
      }
    },
    "schema": "homeboy/workflow/v1",
    "steps": [
      {
        "homeboy": [
          "agent-task",
          "batch-prepare",
          "--issue",
          "{{inputs.issues}}"
        ],
        "id": "prepare"
      },
      {
        "cook": {
          "prompt": "Fix {{item.issue_url}} on {{item.branch}}",
          "repo": "scratch",
          "task-url": "{{item.issue_url}}",
          "verify": [
            "true"
          ]
        },
        "foreach": "{{steps.prepare.output/children}}",
        "id": "cook",
        "join": {
          "min_succeeded": 2
        },
        "max_parallel": 2,
        "needs": [
          "prepare"
        ]
      },
      {
        "always": true,
        "exec": {
          "program": "true"
        },
        "id": "report",
        "needs": [
          "cook"
        ]
      }
    ]
  },
  "events": [
    {
      "event": {
        "event": "start"
      },
      "now_ms": 0
    },
    {
      "event": {
        "event": "step_finished",
        "key": "wf-golden/prepare/1/1",
        "output": {
          "base_sha": "abc123",
          "children": [
            {
              "branch": "fix/issue-1",
              "issue_url": "https://example.test/issues/1"
            },
            {
