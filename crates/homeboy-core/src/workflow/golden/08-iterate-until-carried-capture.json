{
  "definition": {
    "budget": {
      "deadline": "10h",
      "max_step_runs": 12
    },
    "id": "proof",
    "inputs": {
      "url": {
        "required": true
      }
    },
    "iterate": {
      "max_iterations": 3,
      "until": {
        "equals": "accepted",
        "output": "/verdict",
        "step": "evaluate"
      }
    },
    "schema": "homeboy/workflow/v1",
    "steps": [
      {
        "homeboy": [
          "runner",
          "exec",
          "lab",
          "--",
          "node",
          "capture",
          "--url",
          "{{inputs.url}}"
        ],
        "id": "capture",
        "timeout": "15m",
        "when": {
          "not": {
            "outcome": [
              "succeeded"
            ],
            "step": "capture"
          }
        }
      },
      {
        "exec": {
          "args": [
            "evaluate",
            "--fixture",
            "{{steps.capture.output/fixture_root}}",
            "--iteration",
            "{{iteration}}"
          ],
          "program": "node"
        },
        "id": "evaluate",
        "needs": [
          "capture"
        ]
      },
      {
        "cook": {
          "placement": "lab",
          "prompt": "Fix {{steps.evaluate.output/report_path}} for {{inputs.url}}",
          "repo": "scratch",
          "verify": [
            "composer test",
            "node evaluate --fixture {{steps.capture.output/fixture_root}}"
          ]
        },
        "id": "fix",
        "needs": [
          "evaluate"
        ],
        "retry": {
          "max": 1,
          "on": [
            "failed"
          ]
        },
        "when": {
          "equals": "findings",
          "output": "/verdict",
          "step": "evaluate"
        }
      }
    ]
  },
  "events": [
    {
      "event": {
        "event": "start"
      },
      "now_ms": 0
    },
    {
      "event": {
        "event": "step_finished",
        "key": "wf-golden/capture/1/1",
        "output": {
          "fixture_root": "/tmp/f"
        },
        "status": "succeeded"
      },
      "now_ms": 1000
    },
    {
      "event": {
        "event": "step_finished",
        "key": "wf-golden/evaluate/1/1",
        "output": {
          "report_path": "/tmp/r.json",
          "verdict": "findings"
        },
        "status": "succeeded"
      },
      "now_ms": 2000
    },
    {
      "event": {
        "event": "step_finished",
        "key": "wf-golden/fix/1/1",
        "outcome": "candidate_recoverable",
        "run_id": "wf-golden-fix-i1-a1",
        "status": "succeeded"
      },
      "now_ms": 3000
    },
    {
      "event": {
        "event": "step_finished",
        "key": "wf-golden/evaluate/2/1",
        "output": {
          "verdict": "accepted"
        },
        "status": "succeeded"
      },
      "now_ms": 4000
    }
  ],
  "expect_status": "succeeded",
  "inputs": {
