{
  "name": "Node.js",
  "version": "3.2.0",
  "icon": "server.rack",
  "description": "Node.js project type — discovery, audit grammar, and npm release lifecycle",
  "author": "Extra Chill",
  "provides": {
    "file_extensions": ["js", "jsx", "ts", "tsx", "mjs", "cjs", "json"],
    "capabilities": ["format", "validate"]
  },
  "structured_sidecars": {
    "lint.findings": true,
    "test.results": true,
    "test.failures": true,
    "test.coverage": false,
    "bench.results": true,
    "trace.results": true,
    "trace.artifacts": true,
    "annotations": false
  },
  "scripts": {
    "validate": "scripts/validate.sh",
    "format": "scripts/format.sh"
  },
  "platform": {
    "discovery": {
      "find_command": "find /home -name 'package.json' -type f 2>/dev/null | xargs grep -l '\"name\"' 2>/dev/null",
      "base_path_transform": "dirname",
      "display_name_command": "cd {{basePath}} && node -e \"console.log(require('./package.json').name)\" 2>/dev/null || basename {{basePath}}"
    },
    "default_pinned_files": ["package.json", "tsconfig.json", ".npmrc", ".env.example"]
  },
  "component_type": {
    "version_targets": [
      {
        "file": "package.json",
        "pattern": "\"version\":\\s*\"([0-9.]+)\""
      }
    ]
  },
  "settings": [
    {
      "id": "access",
      "label": "Publish Access",
      "type": "string",
      "default": "public",
      "description": "npm publish access level: 'public' or 'restricted'"
    },
    {
      "id": "registry",
      "label": "npm Registry",
      "type": "string",
      "default": "https://registry.npmjs.org",
      "description": "npm registry URL for publishing"
    }
  ],
  "audit": {
    "feature_patterns": [
      "app\\.get\\(['\"]([^'\"]+)['\"]",
      "app\\.post\\(['\"]([^'\"]+)['\"]",
      "app\\.put\\(['\"]([^'\"]+)['\"]",
      "app\\.delete\\(['\"]([^'\"]+)['\"]",
      "app\\.patch\\(['\"]([^'\"]+)['\"]",
      "router\\.get\\(['\"]([^'\"]+)['\"]",
      "router\\.post\\(['\"]([^'\"]+)['\"]",
      "router\\.put\\(['\"]([^'\"]+)['\"]",
      "router\\.delete\\(['\"]([^'\"]+)['\"]",
      "router\\.patch\\(['\"]([^'\"]+)['\"]",
      "app\\.use\\(['\"]([^'\"]+)['\"]",
      "export (?:default )?class (\\w+)",
      "export (?:default )?function (\\w+)",
      "export (?:default )?const (\\w+)",
      "module\\.exports\\s*=\\s*(?:class\\s+|)(\\w+)",
      "mongoose\\.model\\(['\"]([^'\"]+)['\"]",
      "program\\.command\\(['\"]([^'\"]+)['\"]",
      "yargs\\.command\\(['\"]([^'\"]+)['\"]",
      "io\\.on\\(['\"]([^'\"]+)['\"]",
      "socket\\.on\\(['\"]([^'\"]+)['\"]"
    ],
    "feature_labels": {
      "app\\.get\\(": "Express Routes",
      "app\\.post\\(": "Express Routes",
      "app\\.put\\(": "Express Routes",
      "app\\.delete\\(": "Express Routes",
      "app\\.patch\\(": "Express Routes",
      "router\\.get\\(": "Express Routes",
      "router\\.post\\(": "Express Routes",
      "router\\.put\\(": "Express Routes",
      "router\\.delete\\(": "Express Routes",
      "router\\.patch\\(": "Express Routes",
      "app\\.use\\(": "Middleware",
      "export (?:default )?class": "Exported Classes",
      "export (?:default )?function": "Exported Functions",
      "export (?:default )?const": "Exported Constants",
      "module\\.exports": "Module Exports",
      "mongoose\\.model": "Mongoose Models",
      "program\\.command": "CLI Commands",
      "yargs\\.command": "CLI Commands",
      "io\\.on": "Socket Events",
      "socket\\.on": "Socket Events"
    },
    "doc_targets": {
      "Express Routes": {
        "file": "api-reference.md",
        "heading": "## Routes",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Middleware": {
        "file": "api-reference.md",
        "heading": "## Middleware",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Exported Classes": {
        "file": "architecture.md",
        "heading": "## Classes",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Exported Functions": {
        "file": "architecture.md",
        "heading": "## Functions",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Exported Constants": {
        "file": "architecture.md",
        "heading": "## Constants",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Module Exports": {
        "file": "architecture.md",
        "heading": "## Module Exports",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Mongoose Models": {
        "file": "features.md",
        "heading": "## Data Models",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "CLI Commands": {
        "file": "cli-reference.md",
        "heading": "## Commands",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Socket Events": {
        "file": "features.md",
        "heading": "## Socket Events",
        "template": "- `{name}` — `{source_file}` (line {line})"
      }
    }
  },
  "build": {
    "command_template": "bash {{script}}",
    "extension_script": "scripts/build/build-runner.sh",
    "cleanup_paths": [
      "node_modules",
      "dist"
    ],
    "lockfile_paths": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ]
  },
  "lint": {
    "extension_script": "scripts/lint/lint-runner.sh"
  },
  "test": {
    "extension_script": "scripts/test/test-runner.sh"
  },
  "bench": {
    "extension_script": "scripts/bench/bench-runner.sh"
  },
  "trace": {
    "extension_script": "scripts/trace/trace-runner.sh"
  },
  "actions": [
    {
      "id": "release.package",
      "label": "Package release artifacts",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/release/build.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    },
    {
      "id": "release.build",
      "label": "Build package",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/release/build.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    },
    {
      "id": "release.validate",
      "label": "Validate package",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/release/validate.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    },
    {
      "id": "release.publish",
      "label": "Publish to npm registry",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/release/publish.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    }
  ]
}
