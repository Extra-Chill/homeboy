{
  "schema": "homeboy/cloudflare-worker-deploy-contract/v1",
  "repository": { "worktree": ".", "revision": "HEAD", "ref": "refs/heads/example-release" },
  "wrangler": { "binary": "wrangler", "config": "wrangler.toml", "config_ref": "wrangler.toml" },
  "target": { "worker": "example-edge-service", "account_id": "account-id" },
  "expected_bindings": ["CACHE", "API_ORIGIN"],
  "predeploy_commands": [
    { "id": "provision-artifacts", "executable": "npm", "args": ["run", "provision:artifacts", "--", "--remote"], "stdin_secret_input": "artifact-signing-input", "timeout_ms": 300000 }
  ],
  "secret_inputs": [
    { "id": "artifact-signing-input", "env": "EXAMPLE_ARTIFACT_SIGNING_INPUT" }
  ],
  "secrets": [
    { "name": "UPSTREAM_TOKEN", "env": "EXAMPLE_UPSTREAM_TOKEN" },
    { "name": "SIGNING_KEY", "file": "../secure-inputs/signing-key" }
  ],
  "gates": [
    { "id": "health", "url": "https://edge.example.test/health", "expected_status": 200, "expected_text": "healthy" }
  ],
  "durability": { "redeploy_same_revision": true },
  "result_file": "cloudflare-worker-deploy-result.json"
}
