{
  "name": "Cloudflare Workers",
  "id": "cloudflare-workers",
  "version": "0.1.0",
  "icon": "cloud",
  "description": "Immutable Cloudflare Worker deployment, rollback, and durability gates",
  "author": "Extra Chill",
  "provides": {
    "file_extensions": ["json", "toml", "jsonc", "mjs"]
  },
  "cli": {
    "tool": "cloudflare-worker-deploy",
    "display_name": "Cloudflare Worker deploy",
    "command_template": "{{cliPath}} {{extension_path}}/scripts/cloudflare-worker-deploy.mjs {{args}}",
    "default_cli_path": "node"
  },
  "executable": {
    "runtime": {
      "run_command": "node {{extension_path}}/scripts/cloudflare-worker-deploy.mjs {{args}}"
    }
  },
  "deployment_providers": [
    {
      "schema": "homeboy/cloudflare-worker-deploy-command/v1",
      "id": "cloudflare-workers.deploy",
      "label": "Deploy a Cloudflare Worker from an immutable source revision",
      "command": "node {{extension_path}}/scripts/cloudflare-worker-deploy.mjs --contract {{payload.contract}}",
      "dry_run_command": "node {{extension_path}}/scripts/cloudflare-worker-deploy.mjs --dry-run --contract {{payload.contract}}",
      "contract": {
        "input_schema": "homeboy/cloudflare-worker-deploy-contract/v1",
        "result_schema": "homeboy/cloudflare-worker-deploy-result/v1",
        "owns_provider_lifecycle": true,
        "secret_values_in_argv_or_artifacts": false,
        "requires_clean_immutable_source": true
      },
      "capabilities": ["preflight", "bounded-predeploy-commands", "private-command-stdin", "secret-stdin", "post-deploy-http-gates", "rollback-on-failed-gate", "same-revision-durability"]
    }
  ]
}
