{
  "name": "npm",
  "version": "1.0.0",
  "icon": "shippingbox.fill",
  "description": "npm package release lifecycle for libraries and tools",
  "author": "Extra Chill",
  "platform": {
    "discovery": {
      "find_command": "find /home /var/www /srv -maxdepth 6 -name 'package.json' -type f 2>/dev/null | xargs grep -l '\"name\"' 2>/dev/null | head -20",
      "base_path_transform": "dirname",
      "display_name_command": "cd {{basePath}} && node -e \"console.log(require('./package.json').name)\" 2>/dev/null || basename {{basePath}}"
    },
    "default_pinned_files": ["package.json", "tsconfig.json", ".npmrc"],
    "commands": ["npm", "node"]
  },
  "component_type": {
    "version_targets": [
      {
        "file": "package.json",
        "pattern": "\"version\":\\s*\"([0-9.]+)\""
      }
    ]
  },
  "settings": [
    {
      "id": "access",
      "label": "Publish Access",
      "type": "string",
      "default": "public",
      "description": "npm publish access level: 'public' or 'restricted'"
    },
    {
      "id": "registry",
      "label": "npm Registry",
      "type": "string",
      "default": "https://registry.npmjs.org",
      "description": "npm registry URL for publishing"
    }
  ],
  "actions": [
    {
      "id": "release.build",
      "label": "Build package",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/build-npm.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    },
    {
      "id": "release.validate",
      "label": "Validate package",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/validate-npm.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    },
    {
      "id": "release.publish",
      "label": "Publish to npm registry",
      "type": "command",
      "command": "bash \"{{extension_path}}/scripts/publish-npm.sh\"",
      "payload": {
        "release": "{{payload.release}}",
        "config": "{{payload.config}}"
      }
    }
  ],
  "build": {
    "cleanup_paths": [
      "node_modules",
      "dist"
    ]
  },
  "audit": {
    "feature_patterns": [
      "export (?:default )?class (\\w+)",
      "export (?:default )?function (\\w+)",
      "export (?:default )?const (\\w+)",
      "module\\.exports\\s*=\\s*(?:class\\s+|)(\\w+)"
    ],
    "feature_labels": {
      "export (?:default )?class": "Exported Classes",
      "export (?:default )?function": "Exported Functions",
      "export (?:default )?const": "Exported Constants",
      "module\\.exports": "Module Exports"
    },
    "doc_targets": {
      "Exported Classes": {
        "file": "api-reference.md",
        "heading": "## Classes",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Exported Functions": {
        "file": "api-reference.md",
        "heading": "## Functions",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Exported Constants": {
        "file": "api-reference.md",
        "heading": "## Constants",
        "template": "- `{name}` — `{source_file}` (line {line})"
      },
      "Module Exports": {
        "file": "api-reference.md",
        "heading": "## Module Exports",
        "template": "- `{name}` — `{source_file}` (line {line})"
      }
    }
  }
}
