        "**/class-*-registry.php",
        "**/class-*-registries.php",
        "**/class-*-repository.php",
        "**/class-*-repositories.php",
        "**/class-*-adopter.php",
        "**/class-*-adapter.php",
        "**/class-*-bridge.php",
        "**/class-*-resolver.php",
        "**/class-*-handler.php",
