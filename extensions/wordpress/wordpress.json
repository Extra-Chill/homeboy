            "**/class-*-constants.php",
            "**/class-*-configuration.php",
            "**/class-*-options.php",
            "**/*Constants.php",
            "**/Policy/*AccessPolicy.php",
            "**/*Policy.php",
            "**/class-*-policy.php",
            "**/class-*-policy-filter.php",
