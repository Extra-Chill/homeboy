        "**/scripts/lint/php-fixers/reserved-param-fixer.php",
        "**/scripts/lint/php-fixers/text-domain-fixer.php",
        "**/scripts/lint/php-fixers/unused-param-fixer.php",
        "scripts/lint/php-fixers/fixer-helpers.php",
        "scripts/lint/php-fixers/phpcs-ignore-fixer.php",
        "scripts/lint/php-fixers/reserved-param-fixer.php",
        "scripts/lint/php-fixers/text-domain-fixer.php",
        "scripts/lint/php-fixers/unused-param-fixer.php",
        "wordpress/scripts/lint/php-fixers/fixer-helpers.php",
        "wordpress/scripts/lint/php-fixers/phpcs-ignore-fixer.php",
        "wordpress/scripts/lint/php-fixers/reserved-param-fixer.php",
        "wordpress/scripts/lint/php-fixers/text-domain-fixer.php",
        "wordpress/scripts/lint/php-fixers/unused-param-fixer.php",
        "**/class-*-store.php",
