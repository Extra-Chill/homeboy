        "Payload",
        "Policy",
        "Provider",
        "Projector",
        "Registry",
        "Repository",
        "Request",
        "Resolver",
        "Response",
        "Result",
        "Sanitizer",
        "Scheduler",
        "Serializer",
        "Service",
        "Services",
        "Shim",
        "Store",
        "Stub",
        "Secret",
        "Secrets",
        "Transformer",
        "Token",
        "Tokens",
        "Value",
        "Validator",
        "Verifier"
      ],
      "convention_exception_globs": [
