<phpunit
    colors="true"
    verbose="false"
    stopOnFailure="false">

    <testsuites>
        <testsuite name="WordPress Extension Tests">
            <directory>tests/</directory>
        </testsuite>
        <testsuite name="HomeboyWordPress Sniff Tests">
            <directory suffix="UnitTest.php">HomeboyWordPress/Tests/</directory>
        </testsuite>
    </testsuites>

    <php>
        <!-- Extension tests run via the Playground smoke test (scripts/test/playground-dropin-smoke.sh).
             PHPUnit is invoked inside Playground, not on the host. This config is kept for
             tooling compatibility but the bootstrap is handled by playground-runner.php. -->
    </php>
</phpunit>
