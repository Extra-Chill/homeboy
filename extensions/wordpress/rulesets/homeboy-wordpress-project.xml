<?xml version="1.0"?>
<ruleset name="Homeboy WordPress Project">
    <description>
        Baseline WordPress Coding Standards ruleset for Homeboy-managed WordPress
        plugins and themes. Ships as part of the "wordpress" Homeboy extension so
        any consumer can reference it directly instead of hand-rolling PHPCS
        config. Reference the whole file with a single &lt;rule ref&gt; and layer
        project-specific rules or exclusions on top in your own phpcs.xml.dist —
        see wordpress/README.md for the copy-pasteable consumer command and the
        override pattern.
    </description>

    <!-- WordPress-Extra includes WordPress-Core + WordPress-Docs -->
    <rule ref="WordPress-Extra">
        <!-- Exclude naming convention rules to support PSR-4 codebases -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>

        <!-- Exclude PEAR/Squiz function spacing rules that conflict with WordPress formatting -->
        <!-- These rules fight with WordPress spacing rules, causing PHPCBF infinite loops -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
    </rule>

    <!-- PHP 7.4+ compatibility -->
    <config name="testVersion" value="7.4-"/>

    <!--
        Exclude common non-source directories. Deliberately limited to paths
        nobody legitimately wants linted as WordPress runtime source: dependency
        trees (vendor and its prefixed/scoped variants), installed JS packages,
        build/dist output, generic build tooling, and generated php-scoper
        config. PHPCS exclude-patterns are additive only — once a pattern is
        inherited via <rule ref="this-file.xml">, a consuming ruleset cannot
        subtract it, only add more. `tests/` is intentionally NOT excluded here
        for exactly that reason; see wordpress/README.md for the reasoning and
        for how a consumer opts in to excluding it.
    -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/vendor_prefixed/*</exclude-pattern>
    <exclude-pattern>*/vendor-prefixed/*</exclude-pattern>
    <exclude-pattern>*/vendor_scoped/*</exclude-pattern>
    <exclude-pattern>*/vendor-scoped/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/tools/*</exclude-pattern>
    <exclude-pattern>*/scoper.inc.php</exclude-pattern>

    <!-- Show sniff codes in reports for easier targeting -->
    <arg value="s"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

    <!-- Check PHP files only -->
    <arg name="extensions" value="php"/>
</ruleset>
