{
  "id": "wordpress",
  "changelog_target": "docs/CHANGELOG.md",
  "version_targets": [
    {
      "file": "wordpress.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ],
  "recipe_run_providers": [
    {
      "id": "wordpress.wp-codebox.recipe-run",
      "version": "1.5.3",
      "executable": "wp-codebox",
      "command": [
        "wp-codebox",
        "recipe-run",
        "--recipe",
        "{recipe}",
        "--artifacts",
        "{artifacts}",
        "--json"
      ]
    }
  ],
