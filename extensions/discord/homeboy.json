{
  "id": "discord",
  "changelog_target": "docs/CHANGELOG.md",
  "version_targets": [
    {
      "file": "discord.json",
      "pattern": "\"version\":\\s*\"([0-9.]+)\""
    }
  ],
  "self_checks": {
    "lint": [
      "jq empty discord.json",
      "find scripts tests -name '*.mjs' -print0 | xargs -0 -r -n1 node --check"
    ],
    "test": [
      "node tests/notify.test.mjs",
      "node tests/resolve-route.test.mjs"
    ]
  }
}
