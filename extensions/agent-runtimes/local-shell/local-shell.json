{
  "schema": "homeboy/agent-runtime-manifest/v1",
  "id": "local-shell",
  "name": "Local Shell Agent Runtime",
  "version": "1.0.0",
  "description": "Generic local shell executor for deterministic non-WordPress agent task loops.",
  "agent_task_executors": [
    {
      "schema": "homeboy/agent-task-executor-provider/v1",
      "id": "local-shell.agent-task-executor",
      "label": "Local shell agent task executor",
      "backend": "local-shell",
      "command": "node {{runtime_path}}/scripts/agent/local-shell-agent-task-executor.cjs",
      "request_schema": "homeboy/agent-task-request/v1",
      "outcome_schema": "homeboy/agent-task-outcome/v1",
      "request_required_fields": ["schema", "task_id", "executor.backend", "instructions", "executor.config.command"],
      "outcome_statuses": ["succeeded", "failed", "provider_error", "timeout"],
      "failure_classifications": ["request_validation", "provider", "timeout", "execution_failed"],
      "redacted_metadata_keys": ["secret_env_values", "secretEnvValues", "secrets"],
      "capabilities": ["workspace_materialization", "structured_outcome", "diagnostic_artifacts"],
      "workspace_materialization": {
        "cwd": "request_workspace",
        "requires_git": false,
        "write_scope": "workspace"
      },
      "secret_requirements": [],
      "secret_env_requirements": [],
      "provider_defaults": {},
      "diagnostics": {
        "outcome_fields": ["diagnostics", "artifacts", "metadata"],
        "artifact_kinds": []
      },
      "status": "experimental",
      "integration_contract": "homeboy-generic-agent-runtime/v1"
    }
  ]
}
