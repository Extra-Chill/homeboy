{
  "id": "static-site-fixture-matrix",
  "description": "Static Site Importer fixture matrix rig. Discovers arbitrary static HTML fixture roots, writes website artifact bundles, and builds a WP Codebox recipe that runs SSI validation per fixture.",
  "components": {
    "homeboy-extension-wordpress": {
      "path": "${package.root}/wordpress",
      "branch": "main",
      "extensions": {
        "nodejs": {},
        "wordpress": {
          "wp_codebox_wordpress_version": "latest"
        }
      }
    }
  },
  "resources": {
    "paths": [
      "${components.homeboy-extension-wordpress.path}"
    ]
  },
  "pipeline": {
    "check": [
      {
        "kind": "requirement",
        "label": "Static-site fixture matrix runner exists",
        "file": "${components.homeboy-extension-wordpress.path}/scripts/static-site-fixture-matrix.mjs",
        "remediation": "Use a Homeboy Extensions checkout that includes the WordPress static-site fixture matrix runner."
      },
      {
        "kind": "command",
        "label": "Static-site fixture matrix smoke test",
        "cwd": "${components.homeboy-extension-wordpress.path}",
        "command": "npm run test:static-site-fixture-matrix"
      }
    ],
    "up": [],
    "down": []
  }
}
