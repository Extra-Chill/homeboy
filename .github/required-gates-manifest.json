        "pull_request.reopened",
        "workflow_dispatch"
      ],
      "admission_gate": "pr_state_active"
    },
    {
      "id": "test",
      "context": "homeboy / Test",
      "producer": {
        "workflow": ".github/workflows/ci.yml",
        "job": "homeboy",
        "emission": "reusable_workflow_call",
        "called_workflow": "Extra-Chill/homeboy-action/.github/workflows/ci.yml",
        "called_job_name": "Test"
      },
      "aggregation": "reusable_workflow_jobs",
      "required_status_check": true,
      "execution_required_events": [
        "pull_request.opened",
        "pull_request.synchronize",
        "pull_request.reopened",
        "workflow_dispatch"
      ],
      "admission_gate": "pr_state_active"
    },
    {
      "id": "executed",
      "context": "homeboy / Required Gates Executed",
      "producer": {
        "workflow": ".github/workflows/ci.yml",
        "job": "required-gates-executed",
        "emission": "job_name"
      },
      "aggregation": "single_job",
      "required_status_check": true,
      "terminal": true,
      "execution_required_events": [
        "pull_request.opened",
        "pull_request.synchronize",
        "pull_request.reopened",
        "workflow_dispatch"
      ],
      "admission_gate": "pr_state_active"
    }
  ]
}
