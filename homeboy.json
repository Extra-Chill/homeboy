{
  "ci": {
    "pin_repositories": {
      "extension-ref": "Extra-Chill/homeboy-extensions"
    }
  },
  "auto_cleanup": false,
  "autofix_verify": {
    "args": [
      "check",
      "--release"
    ],
    "command": "cargo",
    "timeout_secs": 300
  },
  "build_artifact": "target/release/homeboy",
  "changelog_target": "docs/changelog.md",
  "cleanup_artifacts": [
    {
      "label": "Rust build output",
      "path": "target/"
    }
  ],
  "docs_dir": "docs",
  "extensions": {
    "rust": {
      "settings": {
        "rust_cargo_test_threads": 1,
        "rust_nextest_shard_threads": 0,
        "rust_test_runner": "nextest"
      }
    }
  },
  "hooks": {},
  "id": "homeboy",
  "managed_execution": {
    "shared_cargo_target": true
  },
  "scripts": {
    "build": [
      "cargo build --release"
    ]
  },
  "version_targets": [
    {
      "file": "Cargo.toml",
      "pattern": "(?m)^version\\s*=\\s*\"([0-9.]+)\""
    }
  ]
}
